<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: sem console. O app vive na bandeja; diagnostico sai pelo
         Freedraw.Probe e erros fatais por MessageBox. -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Freedraw.exe, nao Freedraw.App.exe: e o nome que o usuario ve. -->
    <AssemblyName>Freedraw</AssemblyName>
    <!-- Icone do .exe (Explorer, Alt+Tab, Gerenciador de Tarefas). -->
    <ApplicationIcon>Assets\freedraw.ico</ApplicationIcon>
    <!-- O workflow de release sobrescreve com a tag (v1.2.0 -> -p:Version=1.2.0).
         Build local fica em 0.0.0, que nunca se confunde com uma release. -->
    <Version>0.0.0</Version>
  </PropertyGroup>

  <!-- Auto-update so no exe do workflow (-p:AutoUpdate=true). Em build local o
       updater desliga: senao baixaria a release por cima do exe de desenvolvimento. -->
  <ItemGroup Condition="'$(AutoUpdate)' == 'true'">
    <AssemblyMetadata Include="Freedraw.AutoUpdate" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embutido, nao copiado ao lado: o app continua sendo um .exe so. -->
    <EmbeddedResource Include="Assets\freedraw.ico" LogicalName="Freedraw.App.freedraw.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Freedraw.Input\Freedraw.Input.csproj" />
    <ProjectReference Include="..\Freedraw.Ink\Freedraw.Ink.csproj" />
  </ItemGroup>

</Project>
