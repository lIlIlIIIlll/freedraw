<?xml version="1.0" encoding="utf-8"?>
<!--
  Um .exe so, sem instalador e sem depender de .NET instalado na maquina:
    dotnet publish src/Freedraw.App -p:PublishProfile=Portable
  Sai em publish/Freedraw.App.exe (~57 MB: o runtime do .NET vai junto).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Sem isto a libSkiaSharp.dll nativa sai como arquivo separado ao lado do .exe. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\publish\</PublishDir>
  </PropertyGroup>

  <!-- O pacote do SkiaSharp traz libSkiaSharp.pdb (84 MB) como asset nativo, e
       DebugType=none nao alcanca simbolos de pacote. -->
  <Target Name="DropPackagePdbs" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
